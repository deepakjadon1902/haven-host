PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/haven_host
MONGODB_USE_MEMORY=true

# Auth
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Google Auth (Google Identity Services / "Continue with Google")
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com

# Admin (optional; lets frontend admin login work with API auth later)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin@123

# Cloudinary (images)
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Resend (email + OTP)
RESEND_API_KEY=replace_me
RESEND_FROM_EMAIL="Maison Noir <no-reply@yourdomain.com>"
